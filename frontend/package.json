{
  "name": "relay-v2-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc -b --force",
    "gen:api": "openapi-typescript ${VITE_API_PROXY_TARGET:-http://127.0.0.1:7800}/openapi.json -o src/api/schema.d.ts",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@pinia/colada": "^1.3",
    "diff2html": "^3.4",
    "markdown-it": "^14",
    "markdown-it-footnote": "^4",
    "markdown-it-task-lists": "^2",
    "mermaid": "^11",
    "openapi-fetch": "^0.17",
    "pinia": "^3",
    "shiki": "^4",
    "vue": "^3",
    "vue-router": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shikijs/engine-javascript": "^4",
    "@types/node": "^25.9.0",
    "@vitejs/plugin-vue": "^6",
    "@vitest/coverage-v8": "^4",
    "@vue/eslint-config-typescript": "^14",
    "@vue/test-utils": "^2",
    "eslint": "^10",
    "eslint-plugin-vue": "^10",
    "jsdom": "^29",
    "openapi-typescript": "^7",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^7",
    "vitest": "^4",
    "vue-tsc": "^3"
  }
}
